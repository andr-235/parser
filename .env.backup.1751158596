# =============================================================================
# VK Monitor Environment Configuration
# Copy this file to .env and fill in your actual values
# =============================================================================

# Database Configuration
DATABASE_URL=postgresql+asyncpg://vk_monitor:dev_password@localhost:5432/vk_monitor_dev
POSTGRES_DB=vk_monitor_dev
POSTGRES_USER=vk_monitor
POSTGRES_PASSWORD=dev_password

# Redis Configuration
REDIS_URL=redis://:redis_password@redis:6379/0
REDIS_PASSWORD=redis_password

# Application Configuration
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
VK_API_TOKEN=your-vk-api-token-here
VK_API_VERSION=5.131
VK_API_REQUESTS_PER_SECOND=3
VK_API_TIMEOUT=30

# FastAPI Configuration
APP_NAME=VK Comments Monitor
APP_VERSION=1.0.0
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database Configuration (for Docker services)
POSTGRES_DB=vk_monitor_dev
POSTGRES_USER=vk_monitor
POSTGRES_PASSWORD=privet123

# Database Configuration (for FastAPI app)
postgres_user=vk_monitor
postgres_password=privet123
postgres_host=postgres
postgres_port=5432
postgres_db=vk_monitor_dev

# Redis Configuration (for Docker services)
REDIS_PASSWORD=privetredis123

# Redis Configuration (for FastAPI app)
redis_host=redis
redis_port=6379
redis_password=privetredis123
redis_db=0

# Application Configuration
debug=true
LOG_LEVEL=info
log_level=INFO

# VK API Configuration (when implemented)
vk_access_token=privetvkapi123
vk_api_version=5.131

# Security Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
algorithm=HS256
access_token_expire_minutes=30

# Application Info
host=0.0.0.0
port=8000

# Development URLs (adjust for production)
REDIS_URL=redis://:privetredis123@redis:6379/0

# =============================================================================
# SECURITY NOTE:
# - Never commit .env file to version control
# - Use strong, unique passwords for each environment
# - Rotate secrets regularly in production
# =============================================================================
