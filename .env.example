# =============================================================================
# VK Monitor Environment Configuration
# Copy this file to .env and fill in your actual values
# =============================================================================

# Database Configuration
POSTGRES_DB=vk_monitor_dev
POSTGRES_USER=vk_monitor
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Redis Configuration  
REDIS_PASSWORD=your_secure_redis_password_here

# Application Configuration
DEBUG=true
LOG_LEVEL=info

# VK API Configuration (when implemented)
VK_API_TOKEN=your_vk_api_token_here
VK_API_VERSION=5.131

# Security Configuration
SECRET_KEY=your_secret_key_for_jwt_tokens_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Development URLs (adjust for production)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# =============================================================================
# SECURITY NOTE:
# - Never commit .env file to version control
# - Use strong, unique passwords for each environment
# - Rotate secrets regularly in production
# =============================================================================

# ================================
# VK Comments Parser - Environment Variables
# ================================

# Application Configuration
APP_NAME="VK Comments Parser"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Security Configuration
SECRET_KEY="your-super-secret-key-here-minimum-32-characters-long-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
DATABASE_URL="postgresql+asyncpg://vk_monitor:password@localhost:5432/vk_monitor"
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"

# VK API Configuration
VK_API_TOKEN="your-vk-group-access-token-here"
VK_API_VERSION="5.131"
VK_API_REQUESTS_PER_SECOND=3
VK_API_TIMEOUT=30

# API Configuration
API_V1_STR="/api/v1"

# CORS Configuration
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8080,http://localhost:8000"

# Celery Configuration
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Monitoring Configuration
SENTRY_DSN=""
PROMETHEUS_METRICS_PORT=9090
LOG_LEVEL="INFO"

# Email Configuration (optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@example.com"

# File Storage (optional)
UPLOAD_FOLDER="uploads"
MAX_CONTENT_LENGTH=16777216  # 16MB

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Development Options
ENABLE_DOCS=true
ENABLE_REDOC=true
RELOAD_ON_CHANGE=true 